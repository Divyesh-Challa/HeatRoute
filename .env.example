# Optional. HeatRoute runs with no configuration.
# Path to the SQLite visit log (default: backend/heatroute.db)
HEATROUTE_DB=backend/heatroute.db
# Optional shared secret for live devices (hardware/). If set, POST /api/live needs header
# X-Device-Key with this value, and the on-screen device simulator is hidden.
HEATROUTE_DEVICE_KEY=
# Port for the production server (Render sets this automatically)
PORT=8000
